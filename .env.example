# Application
NODE_ENV=production
APP_NAME=BOOM QUEUE SYSTEM
LOG_LEVEL=info

# Discord Developer Portal
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
# Optional: set a development server ID for instant guild command registration
DISCORD_GUILD_ID=

# PostgreSQL — use localhost outside Docker; Compose overrides host to "database"
DATABASE_URL=postgresql://boom_queue:change-this-local-password@localhost:5432/boom_queue?schema=public
# Must match the password used by Compose
POSTGRES_PASSWORD=change-this-local-password

# Discord server locations and role IDs (fill manually after inviting the bot)
# Leave blank to disable the related optional feature.
TICKET_CATEGORY_ID=
STAFF_ROLE_ID=
ANNOUNCEMENT_CHANNEL_ID=
AUDIT_LOG_CHANNEL_ID=
